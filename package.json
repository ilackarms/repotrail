{
  "name": "repotrail",
  "displayName": "RepoTrail",
  "description": "Agent-authored JSON codebase tours in VS Code.",
  "version": "0.11.0",
  "publisher": "repotrail",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ilackarms/repotrail.git"
  },
  "bugs": {
    "url": "https://github.com/ilackarms/repotrail/issues"
  },
  "homepage": "https://github.com/ilackarms/repotrail#readme",
  "keywords": [
    "ai",
    "json",
    "code tour",
    "walkthrough",
    "onboarding"
  ],
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "repoTrail.copyAgentSetup",
        "title": "RepoTrail: Agent Setup"
      },
      {
        "command": "repoTrail.exportTour",
        "title": "RepoTrail: Export Tour"
      },
      {
        "command": "repoTrail.importTour",
        "title": "RepoTrail: Import Tour"
      },
      {
        "command": "repoTrail.saveTourToRepo",
        "title": "RepoTrail: Save Tour to Repo (.repotrail/)"
      },
      {
        "command": "repoTrail.tourFromHere",
        "title": "RepoTrail: Copy Tour From Here Prompt"
      },
      {
        "command": "repoTrail.copySelectionReference",
        "title": "RepoTrail: Copy Selection Reference"
      },
      {
        "command": "repoTrail.showStep",
        "title": "RepoTrail: Show Step"
      },
      {
        "command": "repoTrail.resumeRepoTour",
        "title": "RepoTrail: Resume Repo Tour"
      },
      {
        "command": "repoTrail.renameTour",
        "title": "RepoTrail: Rename Tour"
      },
      {
        "command": "repoTrail.next",
        "title": "RepoTrail: Next Step"
      },
      {
        "command": "repoTrail.back",
        "title": "RepoTrail: Previous Step"
      },
      {
        "command": "repoTrail.revealCurrent",
        "title": "RepoTrail: Jump to Current Step Code"
      },
      {
        "command": "repoTrail.openCurrentSource",
        "title": "RepoTrail: Open Current Step Source"
      },
      {
        "command": "repoTrail.deeper",
        "title": "RepoTrail: Go Deeper"
      },
      {
        "command": "repoTrail.stop",
        "title": "RepoTrail: Stop Tour"
      },
      {
        "command": "repoTrail.cycleTts",
        "title": "RepoTrail: Cycle TTS Mode"
      },
      {
        "command": "repoTrail.speakCurrent",
        "title": "RepoTrail: Speak Current Step"
      },
      {
        "command": "repoTrail.stopTts",
        "title": "RepoTrail: Stop Speech"
      },
      {
        "command": "repoTrail.manageTtsCredentials",
        "title": "RepoTrail: Manage TTS Credentials"
      }
    ],
    "keybindings": [
      {
        "command": "repoTrail.next",
        "key": "alt+right",
        "when": "repoTrail.tourActive"
      },
      {
        "command": "repoTrail.back",
        "key": "alt+left",
        "when": "repoTrail.tourActive"
      },
      {
        "command": "repoTrail.openCurrentSource",
        "key": "alt+o",
        "mac": "cmd+alt+o",
        "when": "repoTrail.tourActive"
      },
      {
        "command": "repoTrail.copySelectionReference",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "repoTrail.tourFromHere",
          "group": "navigation@99",
          "when": "editorTextFocus"
        },
        {
          "command": "repoTrail.copySelectionReference",
          "group": "navigation@98",
          "when": "editorTextFocus && editorHasSelection"
        }
      ],
      "commandPalette": [
        {
          "command": "repoTrail.showStep",
          "when": "false"
        },
        {
          "command": "repoTrail.resumeRepoTour",
          "when": "false"
        },
        {
          "command": "repoTrail.next",
          "when": "repoTrail.tourActive"
        },
        {
          "command": "repoTrail.back",
          "when": "repoTrail.tourActive"
        },
        {
          "command": "repoTrail.revealCurrent",
          "when": "repoTrail.tourActive"
        },
        {
          "command": "repoTrail.openCurrentSource",
          "when": "repoTrail.tourActive"
        },
        {
          "command": "repoTrail.saveTourToRepo",
          "when": "repoTrail.tourActive"
        },
        {
          "command": "repoTrail.renameTour",
          "when": "repoTrail.tourActive"
        },
        {
          "command": "repoTrail.exportTour",
          "when": "repoTrail.tourActive"
        },
        {
          "command": "repoTrail.deeper",
          "when": "repoTrail.tourActive"
        },
        {
          "command": "repoTrail.stop",
          "when": "repoTrail.tourActive"
        },
        {
          "command": "repoTrail.cycleTts",
          "when": "repoTrail.tourActive"
        },
        {
          "command": "repoTrail.speakCurrent",
          "when": "repoTrail.tourActive"
        },
        {
          "command": "repoTrail.stopTts",
          "when": "repoTrail.tourActive"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "repoTrail",
          "title": "RepoTrail",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "repoTrail": [
        {
          "id": "repoTrail.tour",
          "name": "Tour",
          "type": "webview"
        }
      ]
    },
    "configuration": [
      {
        "title": "RepoTrail: Narration",
        "order": 1,
        "properties": {
          "repoTrail.tts.provider": {
            "type": "string",
            "scope": "window",
            "enum": ["off", "kokoro", "system", "say", "elevenlabs", "openai"],
            "enumItemLabels": ["Off", "Kokoro", "System", "Command", "ElevenLabs", "OpenAI"],
            "enumDescriptions": [
              "No narration.",
              "Local Kokoro-82M neural voice. Downloads a model on first use and runs in a Web Worker.",
              "Browser SpeechSynthesis using native OS voices. Free, offline, and the default.",
              "Run a local speech executable such as macOS say, espeak, or spd-say.",
              "Hosted ElevenLabs narration. Configure credentials with RepoTrail: Manage TTS Credentials or ELEVENLABS_API_KEY.",
              "Hosted OpenAI narration. Configure credentials with RepoTrail: Manage TTS Credentials or OPENAI_API_KEY."
            ],
            "default": "system",
            "markdownDescription": "Narration engine. Hosted credentials are stored with **RepoTrail: Manage TTS Credentials**, not in settings.json."
          },
          "repoTrail.tts.kokoroVoice": {
            "type": "string",
            "scope": "window",
            "enum": [
              "af_alloy", "af_aoede", "af_bella", "af_heart", "af_jessica", "af_kore", "af_nicole", "af_nova", "af_river", "af_sarah", "af_sky",
              "am_adam", "am_echo", "am_eric", "am_fenrir", "am_liam", "am_michael", "am_onyx", "am_puck", "am_santa",
              "bf_alice", "bf_emma", "bf_isabella", "bf_lily", "bm_daniel", "bm_fable", "bm_george", "bm_lewis",
              "ef_dora", "em_alex", "em_santa", "ff_siwis", "hf_alpha", "hf_beta", "hm_omega", "hm_psi", "if_sara", "im_nicola",
              "jf_alpha", "jf_gongitsune", "jf_nezumi", "jf_tebukuro", "jm_kumo", "pf_dora", "pm_alex", "pm_santa",
              "zf_xiaobei", "zf_xiaoni", "zf_xiaoxiao", "zf_xiaoyi", "zm_yunjian", "zm_yunxi", "zm_yunxia", "zm_yunyang"
            ],
            "default": "af_heart",
            "description": "Voice used by the local Kokoro provider."
          }
        }
      },
      {
        "title": "RepoTrail: Narration (Advanced)",
        "order": 2,
        "properties": {
          "repoTrail.tts.command": {
            "type": "string",
            "scope": "window",
            "default": "say",
            "description": "Executable name or absolute path used by the Command provider. RepoTrail passes narration as one argument; command-line arguments are not supported. Animated HTML exports use System speech instead."
          },
          "repoTrail.tts.elevenLabsVoiceId": {
            "type": "string",
            "scope": "window",
            "default": "21m00Tcm4TlvDq8ikWAM",
            "description": "ElevenLabs voice id override."
          },
          "repoTrail.tts.elevenLabsModel": {
            "type": "string",
            "scope": "window",
            "default": "eleven_flash_v2_5",
            "description": "ElevenLabs model id override."
          },
          "repoTrail.tts.openAiModel": {
            "type": "string",
            "scope": "window",
            "default": "gpt-4o-mini-tts",
            "description": "OpenAI speech model override. Tone instructions are sent only to steerable gpt-4o models."
          },
          "repoTrail.tts.openAiVoice": {
            "type": "string",
            "scope": "window",
            "default": "ash",
            "description": "OpenAI voice id override, such as ash, sage, alloy, ballad, coral, echo, shimmer, or verse."
          },
          "repoTrail.tts.openAiInstructions": {
            "type": "string",
            "scope": "window",
            "editPresentation": "multilineText",
            "default": "Read this code walkthrough aloud like a friendly senior engineer pair-programming: clear, calm, with natural pacing.",
            "description": "Tone instructions for steerable OpenAI speech models."
          }
        }
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc -p ./ --noEmit",
    "test": "sh -c 'rm -rf out-test && tsc -p ./ --outDir out-test && node --test test/*.test.mjs; status=$?; rm -rf out-test; exit $status'",
    "compile": "node esbuild.mjs",
    "watch": "tsc -watch -p ./ --noEmit",
    "build": "pnpm typecheck && pnpm compile",
    "package": "pnpm build && vsce package --no-dependencies",
    "install-local": "pnpm package && code --install-extension repotrail-$npm_package_version.vsix --force",
    "vscode:prepublish": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "typescript": "^5.4.0"
  }
}
